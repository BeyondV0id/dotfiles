// config3.jsonc - Catnap rounded box skin + Spider-Man logo + bars
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "%USERPROFILE%/fastfetch/logos/spiderman-color.txt",
        "padding": {
            "left": 2,
            "right": 2,
            "top": 1
        }
    },
    "display": {
        "separator": " ",
        "bar": {
            "border": {
                "left": "\uee00",
                "leftElapsed": "\uee03",
                "right": "\uee02",
                "rightElapsed": "\uee05"
            },
            "char": {
                "total": "\uee01",
                "elapsed": "\uee04"
            },
            "color": {
                "total": null
            },
            "width": 20
        }
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31}\uf007 user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#33}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "condition": {
                "!system": "macOS"
            },
            "key": "│ {#34}󰉉 os age  {#keys}│",
            "type": "disk",
            "keyIcon": "󰉉",
            "folders": "/",
            "format": "{create-time:10} [{days} days]"
        },
        {
            "condition": {
                "system": "macOS"
            },
            "key": "│ {#34}󰉉 os age  {#keys}│",
            "type": "disk",
            "keyIcon": "󰉉",
            "folders": "/System/Volumes/VM",
            "format": "{create-time:10} [{days} days]"
        },
        {
            "key": "│ {#35}\uf013 kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#36}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#31}\uf120 term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#32}\uf489 shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#33}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "key": "│ {#34}󰍛 gpu     {#keys}│",
            "type": "gpu"
        },
        {
            "key": "│ {#35}󰉉 disk    {#keys}│",
            "type": "disk",
            "percent": {
                "type": ["bar", "bar-monochrome"]
            }
        },
        {
            "key": "│ {#36}\uf2db memory  {#keys}│",
            "type": "memory",
            "percent": {
                "type": ["bar", "bar-monochrome"]
            }
        },
        {
            "key": "│ {#31}󰂀 battery {#keys}│",
            "type": "battery",
            "percent": {
                "type": ["bar", "bar-monochrome"]
            }
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39}\uf53f colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
