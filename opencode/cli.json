{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["./plugins/cache-stats"],
  "theme": {
    "name": "opencode",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "verbosity": "high",
    "image_preview": true
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal",
    "mode": "on"
  },
  "scroll": {
    "acceleration": true,
    "speed": 2.5
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.7999999999999999
  },
  "terminal": {
    "copy": "manual",
    "title": true
  }
}
