{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest"
        ]
      },
      "paper": {
        "type": "local",
        "command": [
          "C:/Users/harsh/.paper/bin/paper",
          "mcp"
        ],
        "enabled": true
      }
    }
  }
}
